# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` or any real credentials.

# Public Supabase configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Never expose this to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Server-side AI provider key for the itinerary planner. Never expose to client.
AI_API_KEY=
