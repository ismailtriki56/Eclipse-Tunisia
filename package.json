{
  "name": "eclipse-tunisia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "test": "node --import ./scripts/register-ts.mjs --test tests/packages.test.ts tests/times.test.ts tests/availability.test.ts",
    "typecheck": "tsc --noEmit",
    "verify:eclipse": "node --import ./scripts/register-ts.mjs scripts/verify-eclipse.ts",
    "i18n:check": "node --import ./scripts/register-ts.mjs scripts/i18n-check.ts",
    "test:links": "node scripts/test-links.mjs",
    "test:e2e": "playwright test tests/e2e/home.spec.ts tests/e2e/map.spec.ts",
    "test:e2e:screenshots": "playwright test tests/e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
